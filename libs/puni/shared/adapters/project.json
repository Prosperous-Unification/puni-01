{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "puni-shared-adapters",
  "projectType": "library",
  "tags": ["scope:shared", "type:adapters"],
  "metadata": {
    "readWhen": "changing how the file system, git or child processes are reached on this machine",
    "readFirst": "src/index.ts"
  },
  "sourceRoot": "libs/puni/shared/adapters/src",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test src --timeout=20000",
        "cwd": "libs/puni/shared/adapters"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint libs/puni/shared/adapters/src"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --noEmit -p libs/puni/shared/adapters/tsconfig.json"
      }
    },
    "puni-bur-check": {}
  }
}
