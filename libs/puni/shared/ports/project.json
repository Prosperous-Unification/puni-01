{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "puni-shared-ports",
  "projectType": "library",
  "tags": ["scope:shared", "type:shared"],
  "metadata": {
    "readWhen": "changing what the code may ask of the file system, git or child processes",
    "readFirst": "src/index.ts"
  },
  "sourceRoot": "libs/puni/shared/ports/src",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test src --timeout=20000 --pass-with-no-tests",
        "cwd": "libs/puni/shared/ports"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint libs/puni/shared/ports/src"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --noEmit -p libs/puni/shared/ports/tsconfig.json"
      }
    },
    "puni-bur-check": {}
  }
}
