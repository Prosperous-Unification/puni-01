{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "puni-shared-checkout",
  "projectType": "library",
  "tags": ["scope:shared", "type:shared"],
  "metadata": {
    "readWhen": "changing how a repository is located, its files listed, its projects scoped or its wiki index sourced",
    "readFirst": "src/contract.ts"
  },
  "sourceRoot": "libs/puni/shared/checkout/src",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test src --timeout=20000",
        "cwd": "libs/puni/shared/checkout"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint libs/puni/shared/checkout/src"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --noEmit -p libs/puni/shared/checkout/tsconfig.json"
      }
    },
    "puni-bur-check": {}
  }
}
