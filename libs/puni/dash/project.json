{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "puni-dash",
  "projectType": "library",
  "sourceRoot": "libs/puni/dash/src",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "bun test src", "cwd": "libs/puni/dash" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "bunx eslint libs/puni/dash/src" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "bunx tsc --noEmit -p libs/puni/dash/tsconfig.json" }
    }
  }
}
