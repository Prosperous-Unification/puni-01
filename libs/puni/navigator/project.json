{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "puni-navigator",
  "projectType": "library",
  "metadata": {
    "readWhen": "adding or changing a command that plans work or decides what to do next",
    "readFirst": "src/index.ts"
  },
  "sourceRoot": "libs/puni/navigator/src",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "bun test src", "cwd": "libs/puni/navigator" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "bunx eslint libs/puni/navigator/src" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "bunx tsc --noEmit -p libs/puni/navigator/tsconfig.json" }
    }
  }
}
