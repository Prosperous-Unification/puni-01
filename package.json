{
  "name": "puni-01",
  "version": "0.0.0",
  "private": true,
  "nx": {
    "includedScripts": []
  },
  "type": "module",
  "scripts": {
    "puni": "bun apps/puni/cli/src/entrypoint.ts",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "gate": "bun run gate:checks && bun run gate:lint && bun run gate:test",
    "gate:affected": "bun run gate:checks:affected && bun run gate:lint:affected && bun run gate:test:affected",
    "gate:checks": "nx sync:check && { bun fmt --check || { echo 'fix: run bun run fix' >&2; exit 1; }; } && bun run puni burokrat check && nx run-many -t typecheck build",
    "gate:checks:affected": "nx sync:check && { bun fmt --check || { echo 'fix: run bun run fix' >&2; exit 1; }; } && nx affected -t puni-bur-check puni-bur-links && nx affected -t typecheck build",
    "gate:lint": "nx run-many -t lint",
    "gate:lint:affected": "nx affected -t lint",
    "gate:test": "nx run-many -t test",
    "gate:test:affected": "nx affected -t test",
    "fix": "nx sync && bun fmt"
  },
  "dependencies": {
    "@optique/core": "1.4.0",
    "@optique/run": "1.4.0",
    "application-exception": "0.9.0",
    "caught-object-report-json": "15.0.0",
    "configurable-tree-traversal": "0.13.0",
    "di-bag": "0.5.2"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@nx/eslint-plugin": "24.0.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "bun-types": "1.4.5",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "65.5.2",
    "lefthook": "2.2.2",
    "nx": "24.0.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.73.0"
  }
}
