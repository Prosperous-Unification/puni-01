{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "puni-cli",
  "projectType": "application",
  "tags": ["scope:app", "type:app"],
  "metadata": {
    "readWhen": "changing how commands are parsed, dispatched, printed or mapped to exit codes",
    "readFirst": "src/root-parser.ts"
  },
  "sourceRoot": "apps/puni/cli/src",
  "targets": {
    "test": {},
    "lint": {},
    "typecheck": {},
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/puni/cli"],
      "options": {
        "command": "bun build apps/puni/cli/src/entrypoint.ts --target bun --outfile dist/apps/puni/cli/puni.js"
      }
    },
    "puni-bur-check": {}
  }
}
