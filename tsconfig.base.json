{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["bun-types"],
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "paths": {
      "@puni/shared-command": ["./libs/puni/shared/command/src/index.ts"],
      "@puni/shared-failures": ["./libs/puni/shared/failures/src/index.ts"],
      "@puni/shared-ports": ["./libs/puni/shared/ports/src/index.ts"],
      "@puni/shared-adapters": ["./libs/puni/shared/adapters/src/index.ts"],
      "@puni/shared-checkout": ["./libs/puni/shared/checkout/src/index.ts"],
      "@puni/shared-nx": ["./libs/puni/shared/nx/src/index.ts"],
      "@puni/shared-typescript": ["./libs/puni/shared/typescript/src/index.ts"],
      "@puni/shared-records": ["./libs/puni/shared/records/src/index.ts"],
      "@puni/shared-testing": ["./libs/puni/shared/testing/src/index.ts"],
      "@puni/burokrat-check": ["./libs/puni/burokrat/check/src/index.ts"],
      "@puni/burokrat-wiki": ["./libs/puni/burokrat/wiki/src/index.ts"],
      "@puni/burokrat-repo": ["./libs/puni/burokrat/repo/src/index.ts"],
      "@puni/burokrat-adr": ["./libs/puni/burokrat/adr/src/index.ts"],
      "@puni/burokrat-change": ["./libs/puni/burokrat/change/src/index.ts"],
      "@puni/burokrat-skills": ["./libs/puni/burokrat/skills/src/index.ts"],
      "@puni/burokrat-review": ["./libs/puni/burokrat/review/src/index.ts"],
      "@puni/burokrat-assess": ["./libs/puni/burokrat/assess/src/index.ts"],
      "@puni/dash-ops": ["./libs/puni/dash/ops/src/index.ts"],
      "@puni/dash-run": ["./libs/puni/dash/run/src/index.ts"],
      "@puni/dash-progress": ["./libs/puni/dash/progress/src/index.ts"],
      "@puni/dash-resources": ["./libs/puni/dash/resources/src/index.ts"],
      "@puni/dash-release": ["./libs/puni/dash/release/src/index.ts"],
      "@puni/dash-admission": ["./libs/puni/dash/admission/src/index.ts"],
      "@puni/dash-authority": ["./libs/puni/dash/authority/src/index.ts"],
      "@puni/dash-mcp": ["./libs/puni/dash/mcp/src/index.ts"],
      "@puni/dash-pool": ["./libs/puni/dash/pool/src/index.ts"],
      "@puni/navigator-plan": ["./libs/puni/navigator/plan/src/index.ts"],
      "@puni/navigator-research": ["./libs/puni/navigator/research/src/index.ts"],
      "@puni/navigator-progress": ["./libs/puni/navigator/progress/src/index.ts"]
    }
  }
}
