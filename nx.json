{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default", "!{projectRoot}/**/*.test.ts", "!{projectRoot}/**/*.test-host.ts"],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/eslint.config.js",
      "{workspaceRoot}/.prettierrc.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/bun.lock"
    ],
    "puniBurCheck": [
      "{workspaceRoot}/puni.json",
      "{workspaceRoot}/**/.gitignore",
      "{workspaceRoot}/.bun-version"
    ],
    "checkerSource": [
      "{projectRoot}/package.json",
      "{projectRoot}/src/**/*.ts",
      "{projectRoot}/src/**/*.cjs",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/**/*.test-host.ts"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "test": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": ["default", "^production"],
      "options": {
        "command": "bun test src --timeout=20000",
        "cwd": "{projectRoot}",
        "env": {
          "CLAUDECODE": "0",
          "AGENT": "0"
        }
      }
    },
    "lint": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": ["default", "^production"],
      "options": {
        "command": "bunx eslint {projectRoot}/src"
      }
    },
    "typecheck": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": ["default", "^production"],
      "options": {
        "command": "bunx tsc --noEmit -p {projectRoot}/tsconfig.json"
      }
    },
    "puni-bur-check": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "bun apps/puni/cli/src/entrypoint.ts burokrat check --project {projectName}"
      },
      "inputs": [
        "default",
        "puniBurCheck",
        {
          "projects": "puni-cli",
          "input": "checkerSource"
        },
        {
          "projects": "puni-cli",
          "dependencies": true,
          "input": "checkerSource"
        }
      ]
    }
  },
  "sync": {
    "globalGenerators": ["@puni/nx-sync:wiki-index"]
  },
  "plugins": [],
  "pluginsConfig": {
    "@nx/js": {
      "analyzeSourceFiles": true
    }
  },
  "defaultBase": "main",
  "useInferencePlugins": false,
  "analytics": false
}
